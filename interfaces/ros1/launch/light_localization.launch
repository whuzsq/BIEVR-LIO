<launch>
  <!-- 支柱 + 轨道重定位 -->
  <arg name="rviz" default="false"/>
  <!-- 默认复用 GNSS 导出的初始变换，适用于同起点回放；传空值可改用 /initialpose。 -->
  <arg name="initial_correction" default="$(find bievr_lio_ros)/../../Log/gnss_optimization/initial_correction.yaml"/>

  <node pkg="bievr_lio_ros"
      type="process_topics"
      name="bievr_lio_localization_node"
      output="screen"
      args="--sensor_config_file $(find bievr_lio_ros)/../../config/sensor_configs/xiangyang.yaml
            --params_file $(find bievr_lio_ros)/../../config/params.yaml
            --params_file $(find bievr_lio_ros)/../../config/params_light_localization.yaml"/>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find bievr_lio_ros)/rviz/localization.rviz"/>
  </group>
</launch>
