<launch>
  <!-- 建图节点 -->
  <arg name="rviz" default="false"/>

  <include file="$(find bievr_lio_ros)/launch/gnss_recorder.launch">
    <arg name="params" value="$(find bievr_lio_ros)/../../config/params.yaml"/>
  </include>
  <node pkg="bievr_lio_ros" type="process_topics" name="bievr_lio_mapping_node" output="screen"
        args="--sensor_config_file $(find bievr_lio_ros)/../../config/sensor_configs/xiangyang.yaml
              --params_file $(find bievr_lio_ros)/../../config/params.yaml"/>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find bievr_lio_ros)/rviz/config.rviz"/>
  </group>
</launch>
